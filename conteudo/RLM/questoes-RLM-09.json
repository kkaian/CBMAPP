[
  { "id": "RLM-09-0011", "topico": "RLM-09", "enunciado": "Ao se lançar um dado comum de 6 faces, a probabilidade de sair um número par é igual a 1/2.", "gabarito": "C",
    "comentario": "{2, 4, 6}: 3 de 6.", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "drive-q1-RLM-85", "status": "ok" },
  { "id": "RLM-09-0012", "topico": "RLM-09", "enunciado": "A probabilidade de um evento certo é igual a 0.", "gabarito": "E",
    "comentario": "Evento certo: probabilidade **1**. Zero é a do evento impossível.", "dificuldade": 1, "tipo": "conceito", "armadilha": "inversao", "origem": "drive-q1-RLM-87", "status": "ok" },
  { "id": "RLM-09-0013", "topico": "RLM-09", "enunciado": "Ao se lançar uma moeda honesta duas vezes, a probabilidade de se obterem duas caras é 1/4.", "gabarito": "C",
    "comentario": "\\(\\tfrac12 \\times \\tfrac12 = \\tfrac14\\).", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "drive-q1-RLM-88", "status": "ok" },
  { "id": "RLM-09-0014", "topico": "RLM-09", "enunciado": "Em um baralho comum de 52 cartas, a probabilidade de se retirar uma carta de copas é 1/4.", "gabarito": "C",
    "comentario": "13 cartas de copas: \\(\\tfrac{13}{52} = \\tfrac14\\).", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "drive-q1-RLM-90", "status": "ok" },
  { "id": "RLM-09-0015", "topico": "RLM-09", "enunciado": "Dois eventos são independentes quando a ocorrência de um altera a probabilidade do outro.", "gabarito": "E",
    "comentario": "Independentes: um **não** altera o outro (\\(P(A \\cap B) = P(A)\\,P(B)\\)).", "dificuldade": 1, "tipo": "conceito", "armadilha": "inversao", "origem": "drive-q1-RLM-91", "status": "ok" },
  { "id": "RLM-09-0016", "topico": "RLM-09", "enunciado": "Ao se lançar um dado comum, a probabilidade de sair um número maior que 6 é igual a 0.", "gabarito": "C",
    "comentario": "Evento impossível.", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "drive-q1-RLM-92", "status": "ok" },

  { "id": "RLM-09-0017", "topico": "RLM-09", "grupo": "RLM-09-G01", "enunciado": "Ao se lançar o dado uma vez, a probabilidade de se obter um número maior que 4 é igual a 1/2.", "gabarito": "E",
    "comentario": "{5, 6}: 2 de 6 = **1/3**.", "dificuldade": 1, "tipo": "calculo", "armadilha": "numero", "origem": "drive-q2-RLM-65", "status": "ok" },
  { "id": "RLM-09-0018", "topico": "RLM-09", "grupo": "RLM-09-G01", "enunciado": "Ao se lançar o dado uma vez, a probabilidade de se obter um número maior que 4 é igual a 1/3.", "gabarito": "C",
    "comentario": "\\(\\tfrac26 = \\tfrac13\\).", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "drive-q2-RLM-66", "status": "ok" },
  { "id": "RLM-09-0019", "topico": "RLM-09", "grupo": "RLM-09-G01", "enunciado": "Ao se lançarem dois dados, a probabilidade de a soma dos pontos ser igual a 7 é de 1/6.", "gabarito": "C",
    "comentario": "(1,6), (2,5), (3,4), (4,3), (5,2), (6,1): 6 de 36.", "dificuldade": 2, "tipo": "calculo", "armadilha": null, "origem": "drive-q2-RLM-67", "status": "ok" },
  { "id": "RLM-09-0020", "topico": "RLM-09", "grupo": "RLM-09-G01", "enunciado": "Ao se lançarem dois dados, a probabilidade de a soma dos pontos ser igual a 12 é de 1/18.", "gabarito": "E",
    "comentario": "Só (6,6): **1/36**.", "dificuldade": 2, "tipo": "calculo", "armadilha": "numero", "origem": "drive-q2-RLM-68", "status": "ok" },
  { "id": "RLM-09-0021", "topico": "RLM-09", "enunciado": "Para dois eventos quaisquer A e B, tem-se \\(P(A \\cup B) = P(A) + P(B) - P(A \\cap B)\\).", "gabarito": "C",
    "comentario": "Desconta-se a interseção, contada duas vezes.", "dificuldade": 2, "tipo": "conceito", "armadilha": null, "origem": "drive-q2-RLM-69", "status": "ok" },
  { "id": "RLM-09-0022", "topico": "RLM-09", "enunciado": "Se dois eventos são mutuamente exclusivos, a probabilidade de sua ocorrência simultânea é nula.", "gabarito": "C",
    "comentario": "Não podem ocorrer juntos: \\(P(A \\cap B) = 0\\).", "dificuldade": 1, "tipo": "conceito", "armadilha": null, "origem": "drive-q2-RLM-70", "status": "ok" },
  { "id": "RLM-09-0023", "topico": "RLM-09", "enunciado": "Se a probabilidade de ocorrência de um evento é 0,3, a probabilidade de sua não ocorrência é 0,7.", "gabarito": "C",
    "comentario": "Complementar: 1 − 0,3.", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "drive-q2-RLM-71", "status": "ok" },
  { "id": "RLM-09-0024", "topico": "RLM-09", "enunciado": "Se dois eventos A e B são independentes, com P(A) = 0,5 e P(B) = 0,4, então \\(P(A \\cap B) = 0{,}2\\).", "gabarito": "C",
    "comentario": "\\(0{,}5 \\times 0{,}4 = 0{,}2\\).", "dificuldade": 2, "tipo": "calculo", "armadilha": null, "origem": "drive-q2-RLM-72", "status": "ok" },
  { "id": "RLM-09-0025", "topico": "RLM-09", "grupo": "RLM-09-G01", "enunciado": "Ao se retirar uma bola da urna, a probabilidade de ela ser vermelha é de 0,6.", "gabarito": "E",
    "comentario": "\\(\\tfrac{4}{10} = 0{,}4\\). O 0,6 é a das azuis.", "dificuldade": 1, "tipo": "calculo", "armadilha": "inversao", "origem": "drive-q2-RLM-73", "status": "ok" },
  { "id": "RLM-09-0026", "topico": "RLM-09", "grupo": "RLM-09-G01", "enunciado": "Ao se retirarem, sucessivamente e sem reposição, duas bolas da urna, a probabilidade de ambas serem vermelhas é de 2/15.", "gabarito": "C",
    "comentario": "\\(\\tfrac{4}{10} \\times \\tfrac{3}{9} = \\tfrac{12}{90} = \\tfrac{2}{15}\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": null, "origem": "drive-q2-RLM-75", "status": "ok" },
  { "id": "RLM-09-0027", "topico": "RLM-09", "enunciado": "A probabilidade de um evento é sempre um número compreendido entre 0 e 1, inclusive.", "gabarito": "C",
    "comentario": "\\(0 \\le P \\le 1\\).", "dificuldade": 1, "tipo": "conceito", "armadilha": null, "origem": "drive-q2-RLM-76", "status": "ok" },
  { "id": "RLM-09-0028", "topico": "RLM-09", "enunciado": "A probabilidade de um evento pode assumir valor superior a 1, desde que o evento seja composto.", "gabarito": "E",
    "comentario": "Nenhuma probabilidade passa de 1.", "dificuldade": 1, "tipo": "conceito", "armadilha": "absoluto", "origem": "drive-q2-RLM-77", "status": "ok" },

  { "id": "RLM-09-0029", "topico": "RLM-09", "grupo": "RLM-SIM01-A", "enunciado": "Ao se lançarem dois dados honestos, a probabilidade de a soma dos pontos ser maior que 9 é igual a 1/6.", "gabarito": "C",
    "comentario": "Soma 10: 3 casos; 11: 2; 12: 1 → 6 de 36.", "dificuldade": 2, "tipo": "calculo", "armadilha": null, "origem": "simulado-01-38", "status": "ok" },
  { "id": "RLM-09-0030", "topico": "RLM-09", "grupo": "RLM-SIM02-A", "enunciado": "Ao se retirar uma bola da urna, a probabilidade de ela ser verde é igual a 0,625.", "gabarito": "C",
    "comentario": "\\(\\tfrac58 = 0{,}625\\).", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "simulado-02-37", "status": "ok" },
  { "id": "RLM-09-0031", "topico": "RLM-09", "grupo": "RLM-SIM02-A", "enunciado": "Ao se retirarem, sucessivamente e sem reposição, duas bolas da urna, a probabilidade de ambas serem verdes é igual a 5/14.", "gabarito": "C",
    "comentario": "\\(\\tfrac58 \\times \\tfrac47 = \\tfrac{20}{56} = \\tfrac{5}{14}\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": null, "origem": "simulado-02-38", "status": "ok" },
  { "id": "RLM-09-0032", "topico": "RLM-09", "grupo": "RLM-SIM03-A", "enunciado": "Ao se lançar um dado honesto de seis faces, a probabilidade de se obter um múltiplo de 3 é igual a 1/3.", "gabarito": "C",
    "comentario": "{3, 6}: 2 de 6.", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "simulado-03-36", "status": "ok" },
  { "id": "RLM-09-0033", "topico": "RLM-09", "grupo": "RLM-SIM03-A", "enunciado": "Ao se lançarem duas moedas honestas, a probabilidade de se obter pelo menos uma cara é igual a 0,75.", "gabarito": "C",
    "comentario": "1 − P(nenhuma cara) = \\(1 - \\tfrac14\\).", "dificuldade": 2, "tipo": "calculo", "armadilha": null, "origem": "simulado-03-37", "status": "ok" },
  { "id": "RLM-09-0034", "topico": "RLM-09", "grupo": "RLM-SIM04-A", "enunciado": "Ao se lançarem dois dados honestos, a probabilidade de a soma dos pontos ser igual a 5 é de 1/9.", "gabarito": "C",
    "comentario": "(1,4), (2,3), (3,2), (4,1): 4 de 36 = 1/9.", "dificuldade": 2, "tipo": "calculo", "armadilha": null, "origem": "simulado-04-36", "status": "ok" },
  { "id": "RLM-09-0035", "topico": "RLM-09", "grupo": "RLM-SIM05-A", "enunciado": "Ao se lançarem dois dados honestos, a probabilidade de ambos os resultados serem pares é igual a 1/4.", "gabarito": "C",
    "comentario": "\\(\\tfrac12 \\times \\tfrac12\\).", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "simulado-05-37", "status": "ok" },

  { "id": "RLM-09-0036", "topico": "RLM-09", "grupo": "RLM-09-G02", "enunciado": "A probabilidade de os dois extintores retirados terem defeito é de 9/100.", "gabarito": "E",
    "comentario": "9/100 seria com reposição. Sem reposição: \\(\\tfrac{3}{10} \\times \\tfrac29 = \\tfrac{1}{15}\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0037", "topico": "RLM-09", "grupo": "RLM-09-G02", "enunciado": "A probabilidade de os dois extintores retirados terem defeito é de 1/15.", "gabarito": "C",
    "comentario": "\\(\\tfrac{6}{90} = \\tfrac{1}{15}\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0038", "topico": "RLM-09", "grupo": "RLM-09-G02", "enunciado": "A probabilidade de nenhum dos dois extintores retirados ter defeito é de 7/15.", "gabarito": "C",
    "comentario": "\\(\\tfrac{7}{10} \\times \\tfrac69 = \\tfrac{42}{90} = \\tfrac{7}{15}\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0039", "topico": "RLM-09", "grupo": "RLM-09-G02", "enunciado": "A probabilidade de pelo menos um dos extintores retirados ter defeito é de 8/15.", "gabarito": "C",
    "comentario": "Complementar de \"nenhum\": \\(1 - \\tfrac{7}{15}\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0040", "topico": "RLM-09", "grupo": "RLM-09-G02", "enunciado": "A probabilidade de exatamente um dos extintores retirados ter defeito é de 1/2.", "gabarito": "E",
    "comentario": "Duas ordens: \\(2 \\times \\tfrac{3}{10} \\times \\tfrac79 = \\tfrac{42}{90} = \\tfrac{7}{15}\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": "numero", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0041", "topico": "RLM-09", "grupo": "RLM-09-G03", "enunciado": "A probabilidade de a soma dos pontos ser igual a 8 é de 5/36.", "gabarito": "C",
    "comentario": "(2,6), (3,5), (4,4), (5,3), (6,2).", "dificuldade": 2, "tipo": "calculo", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0042", "topico": "RLM-09", "grupo": "RLM-09-G03", "enunciado": "A probabilidade de os dois dados mostrarem o mesmo número é de 1/3.", "gabarito": "E",
    "comentario": "6 duplas iguais em 36 → **1/6**.", "dificuldade": 2, "tipo": "calculo", "armadilha": "numero", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0043", "topico": "RLM-09", "grupo": "RLM-09-G03", "enunciado": "A probabilidade de a soma dos pontos ser par é de 1/2.", "gabarito": "C",
    "comentario": "Soma par: os dois pares (1/4) ou os dois ímpares (1/4) → 1/2.", "dificuldade": 2, "tipo": "calculo", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0044", "topico": "RLM-09", "grupo": "RLM-09-G03", "enunciado": "A probabilidade de o produto dos pontos ser ímpar é de 1/2.", "gabarito": "E",
    "comentario": "Produto ímpar exige os **dois** ímpares: \\(\\tfrac12 \\times \\tfrac12 = \\tfrac14\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0045", "topico": "RLM-09", "grupo": "RLM-09-G03", "enunciado": "A probabilidade de sair pelo menos um 6 é de 1/3.", "gabarito": "E",
    "comentario": "\\(1 - \\left(\\tfrac56\\right)^2 = 1 - \\tfrac{25}{36} = \\tfrac{11}{36}\\). Somar 1/6 + 1/6 conta (6,6) duas vezes.", "dificuldade": 3, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0046", "topico": "RLM-09", "enunciado": "Dois eventos com probabilidades 0,6 e 0,5 podem ser mutuamente exclusivos.", "gabarito": "E",
    "comentario": "Se fossem exclusivos, \\(P(A \\cup B) = 1{,}1 > 1\\), impossível.", "dificuldade": 3, "tipo": "conceito", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0047", "topico": "RLM-09", "enunciado": "Se A e B são eventos independentes, com P(A) = 0,3 e P(B) = 0,4, então a probabilidade de ocorrer A ou B é de 0,7.", "gabarito": "E",
    "comentario": "\\(0{,}3 + 0{,}4 - 0{,}3 \\times 0{,}4 = 0{,}58\\). Somar só vale para eventos exclusivos.", "dificuldade": 3, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0048", "topico": "RLM-09", "enunciado": "Se A e B são eventos independentes, com P(A) = 0,3 e P(B) = 0,4, então a probabilidade de ocorrer A ou B é de 0,58.", "gabarito": "C",
    "comentario": "\\(0{,}7 - 0{,}12 = 0{,}58\\).", "dificuldade": 3, "tipo": "calculo", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0049", "topico": "RLM-09", "enunciado": "Se uma moeda honesta deu cara em cinco lançamentos seguidos, a probabilidade de dar coroa no sexto lançamento é maior que 1/2.", "gabarito": "E",
    "comentario": "Lançamentos independentes: continua 1/2 (falácia do apostador).", "dificuldade": 2, "tipo": "conceito", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0050", "topico": "RLM-09", "enunciado": "Ao se lançarem três moedas honestas, a probabilidade de se obterem três caras é de 1/6.", "gabarito": "E",
    "comentario": "\\(\\left(\\tfrac12\\right)^3 = \\tfrac18\\).", "dificuldade": 2, "tipo": "calculo", "armadilha": "numero", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0051", "topico": "RLM-09", "enunciado": "Em uma família com dois filhos, supondo-se iguais as chances de menino e de menina, a probabilidade de os dois serem meninos é de 1/3.", "gabarito": "E",
    "comentario": "Casos: MM, MF, FM, FF (equiprováveis) → **1/4**.", "dificuldade": 2, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0052", "topico": "RLM-09", "enunciado": "Ao se sortear uma pessoa de um grupo de 4 bombeiros e 6 policiais, a probabilidade de ser sorteado um bombeiro é de 40%.", "gabarito": "C",
    "comentario": "\\(\\tfrac{4}{10} = 40\\%\\).", "dificuldade": 1, "tipo": "calculo", "armadilha": null, "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0053", "topico": "RLM-09", "enunciado": "Uma chance de 1 em 5 corresponde a uma probabilidade de 25%.", "gabarito": "E",
    "comentario": "\\(\\tfrac15 = 20\\%\\).", "dificuldade": 1, "tipo": "calculo", "armadilha": "numero", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0054", "topico": "RLM-09", "enunciado": "Sabendo-se que, no lançamento de um dado honesto, saiu um número par, a probabilidade de esse número ser 2 é de 1/6.", "gabarito": "E",
    "comentario": "O espaço se reduz a {2, 4, 6}: probabilidade **1/3**.", "dificuldade": 3, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0055", "topico": "RLM-09", "enunciado": "Dois eventos independentes, ambos com probabilidade positiva, são necessariamente mutuamente exclusivos.", "gabarito": "E",
    "comentario": "Independentes com P > 0 têm \\(P(A \\cap B) = P(A)P(B) > 0\\): podem ocorrer juntos, logo **não** são exclusivos.", "dificuldade": 3, "tipo": "conceito", "armadilha": "competencia", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0056", "topico": "RLM-09", "enunciado": "Ao se lançarem duas moedas honestas, a probabilidade de se obterem uma cara e uma coroa é de 1/3.", "gabarito": "E",
    "comentario": "CK e KC: 2 de 4 = **1/2**.", "dificuldade": 2, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0057", "topico": "RLM-09", "grupo": "RLM-09-G01", "enunciado": "Ao se retirarem, sucessivamente e com reposição, duas bolas da urna, a probabilidade de ambas serem vermelhas é de 2/15.", "gabarito": "E",
    "comentario": "Com reposição: \\(\\tfrac{4}{10} \\times \\tfrac{4}{10} = \\tfrac{16}{100} = \\tfrac{4}{25}\\). 2/15 é sem reposição.", "dificuldade": 3, "tipo": "calculo", "armadilha": "outro", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0058", "topico": "RLM-09", "enunciado": "Ao se lançar um dado honesto duas vezes, a probabilidade de não sair nenhum 6 é de 5/6.", "gabarito": "E",
    "comentario": "\\(\\tfrac56 \\times \\tfrac56 = \\tfrac{25}{36}\\).", "dificuldade": 2, "tipo": "calculo", "armadilha": "numero", "origem": "inedita", "status": "ok" },
  { "id": "RLM-09-0059", "topico": "RLM-09", "enunciado": "Um evento impossível tem probabilidade igual a 1.", "gabarito": "E",
    "comentario": "Impossível: 0.", "dificuldade": 1, "tipo": "conceito", "armadilha": "inversao", "origem": "inedita", "status": "ok" }
]
