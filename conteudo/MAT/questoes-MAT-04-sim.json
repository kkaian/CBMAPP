[
  {"id":"MAT-04-0070","topico":"MAT-04","grupo":"MAT-SIM04-A","enunciado":"O atendimento pré-hospitalar (APH) respondeu por um terço do total de ocorrências.","gabarito":"C","comentario":"APH = 40 de 120 ocorrências. 40 ÷ 120 = 1/3 ≈ 33,3%.","dificuldade":1,"tipo":"calculo","armadilha":null,"origem":"simulado-04-25","status":"ok"},
  {"id":"MAT-04-0071","topico":"MAT-04","grupo":"MAT-SIM04-A","enunciado":"As ocorrências de resgate corresponderam a exatamente 25% do total.","gabarito":"E","comentario":"25% de 120 = 30. Houve **28** resgates: 28 ÷ 120 ≈ 23,3%, menos que 25%.","dificuldade":2,"tipo":"calculo","armadilha":"numero","origem":"simulado-04-26","status":"ok"},
  {"id":"MAT-04-0072","topico":"MAT-04","grupo":"MAT-SIM04-A","enunciado":"O número de ocorrências de incêndio é o triplo do número de ocorrências de vazamento.","gabarito":"C","comentario":"Incêndio = 27; vazamento = 9. 3 × 9 = 27.","dificuldade":1,"tipo":"calculo","armadilha":null,"origem":"simulado-04-27","status":"ok"},
  {"id":"MAT-04-0073","topico":"MAT-04","grupo":"MAT-SIM04-A","enunciado":"As ocorrências de vazamento representaram mais de 10% do total.","gabarito":"E","comentario":"10% de 120 = 12. Houve **9** vazamentos: 9 ÷ 120 = 7,5%, menos que 10%.","dificuldade":2,"tipo":"calculo","armadilha":"numero","origem":"simulado-04-28","status":"ok"},
  {"id":"MAT-04-0074","topico":"MAT-04","grupo":"MAT-SIM05-A","enunciado":"De janeiro para fevereiro, houve aumento de 25% no número de resgates.","gabarito":"C","comentario":"De 20 para 25: aumento de 5. 5 ÷ 20 = 0,25 = 25% (a base é o valor **inicial**, janeiro).","dificuldade":1,"tipo":"calculo","armadilha":null,"origem":"simulado-05-25","status":"ok"},
  {"id":"MAT-04-0075","topico":"MAT-04","grupo":"MAT-SIM05-A","enunciado":"De abril para maio, houve aumento de 25% no número de resgates.","gabarito":"C","comentario":"De 32 para 40: aumento de 8. 8 ÷ 32 = 0,25 = 25%.","dificuldade":2,"tipo":"calculo","armadilha":null,"origem":"simulado-05-26","status":"ok"},
  {"id":"MAT-04-0076","topico":"MAT-04","grupo":"MAT-SIM05-A","enunciado":"De maio para junho, houve aumento de 15% no número de resgates.","gabarito":"E","comentario":"De 40 para 45: aumento de 5. 5 ÷ 40 = 0,125 = **12,5%**, e não 15%.","dificuldade":2,"tipo":"calculo","armadilha":"numero","origem":"simulado-05-27","status":"ok"},
  {"id":"MAT-04-0077","topico":"MAT-04","grupo":"MAT-SIM05-A","enunciado":"O mês de junho respondeu por mais de 25% do total de resgates do período.","gabarito":"E","comentario":"Total = 20 + 25 + 30 + 32 + 40 + 45 = 192. 25% de 192 = 48. Junho teve 45, **menos** que 48 (45 ÷ 192 ≈ 23,4%).","dificuldade":3,"tipo":"calculo","armadilha":"numero","origem":"simulado-05-28","status":"ok"},
  {"id":"MAT-04-0078","topico":"MAT-04","grupo":"MAT-SIM05-A","enunciado":"De janeiro a junho, o número de resgates cresceu 125%.","gabarito":"C","comentario":"De 20 para 45: aumento de 25. 25 ÷ 20 = 1,25 = 125%. Cuidado: 45 é 225% de 20, mas o **aumento** é de 125%.","dificuldade":3,"tipo":"calculo","armadilha":"inversao","origem":"simulado-05-29","status":"ok"}
